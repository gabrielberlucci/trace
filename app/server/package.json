{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "build": "npx prisma generate && tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server/src/server.js",
    "dev": "tsx watch src/server.ts",
    "worker:upload-xml": "tsx watch src/workers/upload.xml.worker.ts",
    "worker:prod": "tsx src/workers/upload.xml.worker.ts",
    "distClean": "node -e \"require('fs').rm('./dist', { recursive: true, force: true }, (err) => { if (err) throw err; console.log('Directory deleted.'); });\"",
    "modulesClean": "node -e \"require('fs').rm('./node_modules', { recursive: true, force: true }, (err) => { if (err) throw err; console.log('Directory deleted.'); });\"",
    "test": "vitest"
  },
  "keywords": [],
  "author": "Gabriel Berlucci",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@app/shared": "workspace:*",
    "@axiomhq/js": "^2.0.0",
    "@axiomhq/pino": "^1.6.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@xmldom/xmldom": "^0.9.10",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "fast-xml-validator": "^1.4.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui": "^5.32.6",
    "swagger-ui-express": "^5.0.1",
    "xml-crypto": "^6.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui": "^5.32.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web": "^0.0.354",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
