// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id            Int            @id @default(autoincrement())
  document      String         @unique
  typePerson    typePerson
  name          String
  fantasyName   String?
  birthdate     DateTime?
  phone         String?
  address       String?
  zipcode       String?
  addressNumber Int?
  neighborhood  String?
  complement    String?
  email         String?        @unique
  ie            String?        @unique
  active        Boolean        @default(true)
  city          City?          @relation(fields: [cityId], references: [id])
  cityId        Int?
  sale          Sale[]
  serviceOrders ServiceOrder[]
}

model Supplier {
  id               Int               @id @default(autoincrement())
  document         String            @unique
  typePerson       typePerson        @default(PJ) // IDK IF ITS NECESSARY, BUT MAYBE WILL BE BAYED FROM A GUY WITH CPF? WHY NOT.
  name             String
  fantasyName      String?
  phone            String?
  address          String?
  zipcode          String?
  addressNumber    Int?
  complement       String?
  neighborhood     String?
  email            String?           @unique
  ie               String?           @unique
  active           Boolean           @default(true)
  city             City?             @relation(fields: [cityId], references: [id])
  cityId           Int?
  supplierProducts SupplierProduct[]
  pendingProducts  PendingProduct[]
}

model Product {
  id               Int               @id @default(autoincrement())
  description      String
  barcode          String            @unique
  unity            Unity
  currentStock     Float             @default(0)
  costPrice        Decimal           @db.Decimal(9, 2)
  salePrice        Decimal           @db.Decimal(9, 2)
  movement         StockMovement[]
  item             SaleItem[]
  categories       Category?         @relation(fields: [categoriesId], references: [id])
  categoriesId     Int?
  supplierProducts SupplierProduct[]
}

model StockMovement {
  id           Int      @id @default(autoincrement())
  quantity     Float // REMEMBER IT CAN BE METERS OF SOMETHING
  date         DateTime @default(now())
  typeMovement Movement

  product            Product           @relation(fields: [productId], references: [id])
  productId          Int
  saleItem           SaleItem?         @relation(fields: [saleItemId], references: [id])
  saleItemId         Int?
  nfeUploadControl   NfeUploadControl? @relation(fields: [nfeUploadControlId], references: [id])
  nfeUploadControlId Int?

  @@index([typeMovement, date])
}

model City {
  id        Int        @id // come from API SEED
  name      String?
  state     String?
  customers Customer[]
  suppliers Supplier[]
  users     User[]
  companies Company[]
}

model User {
  id                Int            @id @default(autoincrement())
  name              String
  birthdate         DateTime?
  phone             String?
  address           String?
  zipcode           String?
  addressNumber     Int?
  complement        String?
  neighborhood      String?
  email             String?        @unique
  password          String
  username          String         @unique
  active            Boolean        @default(true)
  role              Role           @relation(fields: [roleId], references: [id])
  city              City?          @relation(fields: [cityId], references: [id])
  cityId            Int?
  roleId            Int
  sale              Sale[]
  createdCategories Category[]     @relation("CategoryCreatedBy")
  updatedCategories Category[]     @relation("CategoryUpdatedBy")
  notifications     Notification[]
}

model Sale {
  id              Int           @id @default(autoincrement())
  saleItem        SaleItem[]
  customer        Customer      @relation(fields: [customerId], references: [id])
  customerId      Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId Int
  user            User          @relation(fields: [userId], references: [id])
  userId          Int
  date            DateTime      @default(now())
  company         Company?      @relation(fields: [companyId], references: [id])
  companyId       Int?
}

model SaleItem {
  id          Int             @id @default(autoincrement())
  description String
  barcode     String
  quantity    Float // IT CAN BE METERS, MM OR SOMETHING LIKE THAT
  costPrice   Decimal
  salePrice   Decimal
  totalPrice  Decimal
  date        DateTime        @default(now())
  movement    StockMovement[]
  sale        Sale            @relation(fields: [saleId], references: [id])
  saleId      Int
  product     Product         @relation(fields: [productId], references: [id])
  productId   Int
}

model TotalCount {
  id        Int    @id @default(autoincrement())
  tableName String @unique
  total     Int
}

model PaymentMethod {
  id          Int         @id @default(autoincrement())
  description String
  active      Boolean     @default(true)
  fee         Decimal?    @db.Decimal(9, 2)
  type        PaymentType
  sale        Sale[]

  createdAt DateTime @default(now())
}

model Role {
  id         Int              @id @default(autoincrement())
  name       String           @unique
  level      Int
  user       User[]
  permission RolePermission[]
}

model Permission {
  id   Int              @id @default(autoincrement())
  name String           @unique
  role RolePermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId Int

  @@unique([roleId, permissionId])
}

model Company {
  id            Int            @id @default(autoincrement())
  document      String         @unique
  name          String
  fantasyName   String?
  phone         String?
  address       String?
  zipcode       String?
  addressNumber Int?
  complement    String?
  neighborhood  String?
  email         String?        @unique
  ie            String?        @unique
  active        Boolean        @default(true)
  city          City?          @relation(fields: [cityId], references: [id])
  cityId        Int?
  serviceOrders ServiceOrder[]
  sale          Sale[]
}

model NfeUploadControl {
  id           Int             @id @default(autoincrement())
  nfeAccessKey String          @unique
  numNf        String
  serieNf      String
  processedAt  DateTime
  createdAt    DateTime        @default(now())
  movement     StockMovement[]
}

model ServiceOrder {
  id       Int      @id @default(autoincrement())
  date     DateTime
  customer Customer @relation(fields: [customerId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  serviceOrderItems ServiceOrderItem[]
  customerId        Int
  companyId         Int
}

model ServiceOrderItem {
  id             Int          @id @default(autoincrement())
  date           DateTime
  description    String
  hours          Decimal      @db.Decimal(9, 2)
  hourlyRate     Decimal      @db.Decimal(9, 2)
  totalPrice     Decimal      @db.Decimal(9, 2)
  note           String?
  order          ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  serviceOrderId Int
}

/**
 * i could make a enum, but idk all the categories that can have
 */

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  product   Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdById Int
  createdBy   User @relation("CategoryCreatedBy", fields: [createdById], references: [id])

  updatedById Int?
  updatedBy   User? @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
}

model Notification {
  id        Int              @id @default(autoincrement())
  message   String
  isRead    Boolean
  type      NotificationType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User?            @relation(fields: [userId], references: [id])
  userId    Int?
}

model SupplierProduct {
  id           Int      @default(autoincrement())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId   Int
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierCode String

  supplierDesc String?

  conversionFactor Float @default(1)

  @@id([productId, supplierId])
  @@unique([supplierId, supplierCode])
}

model PendingProduct {
  id Int @id @default(autoincrement())

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  supplierCode String
  supplierDesc String
  barcode      String
  unity        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolved  Boolean  @default(false)

  @@unique([supplierId, supplierCode])
}

// MAKE SERVICE MODEL

enum typePerson {
  PF
  PJ
}

enum Unity {
  UN
  CM
  MT
  MM
  BALDE
  LITRO
}

enum Movement {
  VENDAS
  SERVICO
  PERDA
  IMPORTACAO
  AJUSTE_ENTRADA
  AJUSTE_SAIDA
}

enum PaymentType {
  POS
  TEF
  PIX
  OUTRO
  CREDITO
  DEBITO
}

enum RoleType {
  ADMIN
  CAIXA
}

enum NotificationType {
  IMPORTACAO_XML
}
