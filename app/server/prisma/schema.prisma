// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id            Int            @id @default(autoincrement())
  document      String         @unique
  typePerson    typePerson
  name          String
  fantasyName   String?
  birthdate     DateTime?
  phone         String?
  address       String?
  zipcode       String?
  addressNumber Int?
  neighborhood  String?
  complement    String?
  email         String?        @unique
  ie            String?        @unique
  active        Boolean        @default(true)
  city          City?          @relation(fields: [cityId], references: [id])
  cityId        Int?
  sale          Sale[]
  serviceOrders ServiceOrder[]
}

model Supplier {
  id            Int        @id @default(autoincrement())
  document      String     @unique
  typePerson    typePerson @default(PJ) // IDK IF ITS NECESSARY, BUT MAYBE WILL BE BAYED FROM A GUY WITH CPF? WHY NOT.
  name          String
  fantasyName   String?
  phone         String?
  address       String?
  zipcode       String?
  addressNumber Int?
  complement    String?
  neighborhood  String?
  email         String?    @unique
  ie            String?    @unique
  active        Boolean    @default(true)
  city          City?      @relation(fields: [cityId], references: [id])
  cityId        Int?
  products      Product[]
}

model Product {
  id           Int             @id @default(autoincrement())
  description  String
  barcode      String          @unique
  unity        Unity
  currentStock Float           @default(0)
  costPrice    Decimal         @db.Decimal(9, 2)
  salePrice    Decimal         @db.Decimal(9, 2)
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])
  supplierId   Int?
  movement     StockMovement[]
  item         SaleItem[]
}

model StockMovement {
  id           Int      @id @default(autoincrement())
  quantity     Float // REMEMBER IT CAN BE METERS OF SOMETHING
  date         DateTime @default(now())
  typeMovement Movement

  product    Product   @relation(fields: [productId], references: [id])
  productId  Int
  saleItem   SaleItem? @relation(fields: [saleItemId], references: [id])
  saleItemId Int?
}

model City {
  id        Int        @id // come from API SEED
  name      String?
  state     String?
  customers Customer[]
  suppliers Supplier[]
  users     User[]
  companies Company[]
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  birthdate     DateTime?
  phone         String?
  address       String?
  zipcode       String?
  addressNumber Int?
  complement    String?
  neighborhood  String?
  email         String?   @unique
  password      String
  username      String    @unique
  active        Boolean   @default(true)
  role          Role      @relation(fields: [roleId], references: [id])
  city          City?     @relation(fields: [cityId], references: [id])
  cityId        Int?
  roleId        Int
  sale          Sale[]
}

model Sale {
  id              Int           @id @default(autoincrement())
  saleItem        SaleItem[]
  customer        Customer      @relation(fields: [customerId], references: [id])
  customerId      Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId Int
  user            User          @relation(fields: [userId], references: [id])
  userId          Int
  date            DateTime      @default(now())
  company         Company?      @relation(fields: [companyId], references: [id])
  companyId       Int?
}

model SaleItem {
  id          Int             @id @default(autoincrement())
  description String
  barcode     String
  quantity    Float // IT CAN BE METERS, MM OR SOMETHING LIKE THAT
  costPrice   Decimal
  salePrice   Decimal
  totalPrice  Decimal
  date        DateTime        @default(now())
  movement    StockMovement[]
  sale        Sale            @relation(fields: [saleId], references: [id])
  saleId      Int
  product     Product         @relation(fields: [productId], references: [id])
  productId   Int
}

model TotalCount {
  id        Int    @id @default(autoincrement())
  tableName String @unique
  total     Int
}

model PaymentMethod {
  id          Int         @id @default(autoincrement())
  description String
  active      Boolean     @default(true)
  fee         Decimal?    @db.Decimal(9, 2)
  type        PaymentType
  sale        Sale[]

  createdAt DateTime @default(now())
}

model Role {
  id         Int              @id @default(autoincrement())
  name       String           @unique
  level      Int
  user       User[]
  permission RolePermission[]
}

model Permission {
  id   Int              @id @default(autoincrement())
  name String           @unique
  role RolePermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId Int

  @@unique([roleId, permissionId])
}

model Company {
  id            Int            @id @default(autoincrement())
  document      String         @unique
  name          String
  fantasyName   String?
  phone         String?
  address       String?
  zipcode       String?
  addressNumber Int?
  complement    String?
  neighborhood  String?
  email         String?        @unique
  ie            String?        @unique
  active        Boolean        @default(true)
  city          City?          @relation(fields: [cityId], references: [id])
  cityId        Int?
  serviceOrders ServiceOrder[]
  sale          Sale[]
}

model NfeUploadControl {
  id           Int      @id @default(autoincrement())
  nfeAccessKey String   @unique
  numNf        String
  serieNf      String
  processedAt  DateTime
  createdAt    DateTime @default(now())
}

model ServiceOrder {
  id       Int      @id @default(autoincrement())
  date     DateTime
  customer Customer @relation(fields: [customerId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  serviceOrderItems ServiceOrderItem[]
  customerId        Int
  companyId         Int
}

model ServiceOrderItem {
  id             Int          @id @default(autoincrement())
  date           DateTime
  description    String
  hours          Decimal      @db.Decimal(9, 2)
  hourlyRate     Decimal      @db.Decimal(9, 2)
  totalPrice     Decimal      @db.Decimal(9, 2)
  note           String?
  order          ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  serviceOrderId Int
}

// MAKE SERVICE MODEL

enum typePerson {
  PF
  PJ
}

enum Unity {
  UN
  CM
  MT
  MM
}

enum Movement {
  VENDAS
  SERVICO
  AJUSTE
  PERDA
  IMPORTACAO
}

enum PaymentType {
  POS
  TEF
  PIX
  OUTRO
  CREDITO
  DEBITO
}

enum RoleType {
  ADMIN
  CAIXA
}
